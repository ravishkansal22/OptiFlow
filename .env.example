# OptiFlow Environment Configuration
# API Keys (Optional - built-in Mireye Gateway simulator active if not provided)
MIREYE_API_KEY=your_mireye_api_key_here
MIREYE_BASE_URL=https://api.mireye.ai/v1

# LLM Keys for Narrator Agent (Optional - intelligent rule/prompt generator fallback active if unset)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (Optional - in-memory LRU cache fallback active if Redis is offline)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
