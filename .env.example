# OptiFlow Environment Configuration
# API Keys (Optional - built-in Mireye Gateway simulator active if not provided)
# NOTE: Mireye v1 covers US coordinates only. Points outside the US return
# coord_out_of_bounds and fall back to simulated values.
MIREYE_API_KEY=your_mireye_api_key_here
MIREYE_BASE_URL=https://api.mireye.com

# A first lookup for a cold coordinate can exceed 10s; later ones are sub-second.
# Too low a timeout silently substitutes simulated values, so keep this generous.
MIREYE_TIMEOUT=30
MIREYE_MAX_ATTEMPTS=2

# Strict mode defaults ON whenever MIREYE_API_KEY is set: a failed site lookup
# raises rather than silently substituting simulated values. Routing legs the API
# cannot drive are flagged but not fatal. Set to 0 to allow the fallback.
MIREYE_STRICT_LIVE=1

# Hard client-side cap on outbound calls. Mireye allows 300/min; this token
# bucket keeps every agent and request combined under the limit.
MIREYE_MAX_CALLS_PER_MIN=250

# LLM Keys for Narrator Agent's "Ask OptiFlow" chatbot (/api/ask). Every answer is
# grounded in the network state on screen -- candidates, graph, frontier, active
# solution -- passed to the model as context, so it can't invent facts. Gemini is
# tried first if both are set, falling back to OpenAI on failure. If neither is
# set, a deterministic rule/template fallback answers instead so the chatbot
# still works offline.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_NARRATOR_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_NARRATOR_MODEL=gemini-2.5-flash

# Redis Configuration (Optional - in-memory LRU cache fallback active if Redis is offline)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Server Configuration
# A baseline run is dispatched at startup so a network is waiting on first load.
# Set to 0 to boot idle and let the UI drive every phase itself.
OPTIFLOW_BASELINE_ON_STARTUP=1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
