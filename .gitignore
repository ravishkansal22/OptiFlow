# ---------------------------------------------------------------- secrets
# .env holds MIREYE_API_KEY, OPENAI_API_KEY and GEMINI_API_KEY.
# .env.example is the committed template and must stay tracked.
.env
.env.*
!.env.example

# ------------------------------------------------------------ python venv
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# ------------------------------------------------------ python artefacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
*.egg-info/
.eggs/

# --------------------------------------------------------- python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ------------------------------------------------------------------- node
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------- vite
# The image builds the frontend itself (frontend/Dockerfile runs `npm run
# build`), so the compiled bundle does not belong in the repository.
dist/
.vite/
vite.config.*.timestamp-*
*.local

# ------------------------------------------------- generated run output
# Timestamped agent-test artefacts written by test_agents_with_mireye_api.py.
test_reports/
*.log
logs/

# ---------------------------------------------------------------- editors
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------ claude code
# Project-level .claude config is shareable; personal overrides are not.
.claude/settings.local.json

